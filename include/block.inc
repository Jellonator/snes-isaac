; BLOCK TYPES
.DEFINE BLOCK_HOLE        $00
.DEFINE BLOCK_ROCK        $01
.DEFINE BLOCK_ROCK_TINTED $02
.DEFINE BLOCK_POOP        $03
.DEFINE BLOCK_METAL       $04
.DEFINE BLOCK_IMPERVIOUS  $7F
.DEFINE BLOCK_GROUND      $80
.DEFINE BLOCK_LOGS        $81
.DEFINE BLOCK_SPIKE       $82

; blocks of type >= $80 are non-solid
; blocks of type $00 are 'solid' to non-flyers
.DEFINE BLOCKMASK_IS_NONSOLID $80

; regular (empty) block variants
.DEFINE BLOCK_GROUND_VARIANT_RUBBLE $01